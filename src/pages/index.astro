---
import Layout from '../layouts/Layout.astro';
import PostList from '../components/PostList.astro';
import { site } from '../config';
import { getPosts } from '../lib/posts';
const posts = site.showWriting ? (await getPosts()).slice(0, 3) : [];
const links = [
  { label: 'Email', url: site.email ? `mailto:${site.email}` : '' },
  { label: 'GitHub', url: site.github },
  { label: 'LinkedIn', url: site.linkedin },
  { label: 'Twitter/X', url: site.twitter },
  { label: 'Google Scholar', url: site.scholar },
  { label: 'Book a conversation', url: site.booking },
];
---
<Layout>
  <section class="hero">
    <h1>Sayam Goyal</h1>
    <p class="intro">I’m a computer science student interested in tech, AI, language models, and quant.</p>
    <p class="intro">A small place for things I’m building and learning.</p>
    <div class="hero-links" aria-label="Find me online">
      {links.map(link => link.url ? <a href={link.url} target={link.url.startsWith('mailto:') ? undefined : '_blank'} rel={link.url.startsWith('mailto:') ? undefined : 'noopener noreferrer'}>{link.label}</a> : <span class="unconfigured" title="Coming soon">{link.label}<span class="sr-only"> (coming soon)</span></span>)}
    </div>
  </section>
  {site.showWriting && <section class="section" aria-labelledby="writing-title">
    <div class="section-heading"><h2 id="writing-title">Writing</h2><a href="/blog/">All posts →</a></div>
    <PostList posts={posts} />
  </section>}
  {site.showProjects && <section class="section" aria-labelledby="projects-title">
    <h2 id="projects-title">Projects</h2>
    <p class="section-description">A few experiments in code. More soon.</p>
    <a href="/projects/">Browse projects →</a>
  </section>}
</Layout>
