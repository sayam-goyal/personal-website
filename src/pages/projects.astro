---
import Layout from '../layouts/Layout.astro';
import { projects, site } from '../config';
---
<Layout title="Projects">
  <section class="page-intro"><h1>Projects</h1><p class="intro">Experiments in AI, data, and code.</p></section>
  <p class="editor-note">The entries below are starter ideas, not completed projects. Real work will land here as it takes shape.</p>
  <div class="project-list">{projects.map((project) => <article class="project-item"><div><p class="eyebrow mono">{project.category}</p><h2>{project.title}</h2><p>{project.description}</p>{project.url ? <a class="text-link" href={project.url} target="_blank" rel="noopener noreferrer">Explore project ↗</a> : <span class="sample-label mono">Idea · coming soon</span>}</div></article>)}</div>
  <p class="closing-note">In the meantime, find me on <a href={site.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>.</p>
</Layout>
