---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../lib/posts';
interface Props { posts: CollectionEntry<'blog'>[]; }
const { posts } = Astro.props;
---
<div class="post-list">
  {posts.map(post => <a class="post-row" href={`/blog/${post.id}/`}>
    <span class="post-date mono">{formatDate(post.data.date)}</span>
    <div><h3>{post.data.title}</h3><p>{post.data.description}</p>
    {post.data.sample && <span class="sample-label mono">Sample post</span>}</div>
  </a>)}
</div>
